{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nootropic-fm",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "routes": [
    { "pattern": "nootropic.fm", "custom_domain": true },
    { "pattern": "www.nootropic.fm", "custom_domain": true },
    { "pattern": "app.nootropic.fm", "custom_domain": true }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nootropic-fm-db",
      "database_id": "4767875c-6348-4d02-8398-8f2c77f03a85",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "nootropic-fm-audio"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "APP_ENV": "open-research-beta",
    "ENABLE_LLM_PARSE": "false",
    "GEMINI_DAILY_CAP": "100",
    "MUSIC_PROVIDER": "lyria",
    "MUSIC_GEN_DAILY_CAP": "3"
  }
}
