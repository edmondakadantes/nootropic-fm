{
  "name": "nootropic-fm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android:web": "tsc -b && vite build --config vite.capacitor.config.ts",
    "android:sync": "npm run build:android:web && npx cap sync android && node scripts/generate-playstore-assets.mjs",
    "playstore:assets": "node scripts/generate-playstore-assets.mjs",
    "playstore:dry-run": "node scripts/publish-google-play.mjs --dry-run",
    "playstore:publish": "node scripts/publish-google-play.mjs",
    "test:dsp": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply nootropic-fm-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply nootropic-fm-db --remote",
    "upload:stems": "node scripts/upload-stems.mjs",
    "deploy": "npm run build && wrangler deploy --config dist/nootropic_fm/wrangler.json"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@types/qrcode": "^1.5.6",
    "lucide-react": "^0.511.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "@cloudflare/vite-plugin": "^1.3.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "google-auth-library": "^11.3.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.2",
    "wrangler": "^4.14.0"
  }
}
